      "id": "ntc0",
      "top": -160,
      "left": -220,
      "attrs": { "temperature": "25" }
    },
    {
      "type": "wokwi-ntc-temperature-sensor",
      "id": "ntc1",
      "top": -80,
      "left": -220,
      "attrs": { "temperature": "25" }
    },
    {
      "type": "wokwi-ntc-temperature-sensor",
      "id": "ntc2",
      "top": 0,
      "left": -340,
      "attrs": { "temperature": "25" }
    },
    {
      "type": "wokwi-ntc-temperature-sensor",
      "id": "ntc3",
      "top": 80,
      "left": -340,
      "attrs": { "temperature": "24" }
