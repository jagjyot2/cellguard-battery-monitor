    [ "esp:17", "led_alarm:A", "red", [ "h0" ] ],
    [ "led_alarm:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:18", "led_status:A", "green", [ "h0" ] ],
    [ "led_status:C", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:19", "buzzer_alert:1", "orange", [ "h0" ] ],
    [ "buzzer_alert:2", "esp:GND.1", "black", [ "v0" ] ],

    [ "esp:4", "btn_cal:1.l", "blue", [ "h0" ] ],
    [ "btn_cal:2.l", "esp:GND.1", "black", [ "v0" ] ]
