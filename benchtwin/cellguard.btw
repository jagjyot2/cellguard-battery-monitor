  "netlist": "(export (version \"E\")\n  (design\n    (source \"cellguard.kicad_sch\")\n    (date \"2026-11-18\")\n    (tool \"KiCad 8.0\")\n    (sheet (number \"1\") (name \"/\") (tstamps \"/\")\n      (title_block\n        (title \"CellGuard 21700 Pack Telemetry Monitor (1S-6S)\")\n        (company \"Jagjyot Engineering Portfolio\")\n        (rev \"1.0\")\n        (comment (number \"1\") (value \"SAFETY: Monitor-only instrument used alongside external commercial BMS + main fuse\")))))\n  (components\n    (comp (ref \"U1\") (value \"ESP32-DevKitC-32E\") (footprint \"Module:ESP32-WROOM-32E\") (property (name \"MPN\") (value \"ESP32-WROOM-32E-N4\")) (property (name \"Manufacturer\") (value \"Espressif\")))\n    (comp (ref \"U2\") (value \"AMS1117-3.3\") (footprint \"Package_TO_SOT_SMD:SOT-223-3_TabPin2\") (property (name \"MPN\") (value \"AMS1117-3.3\")) (property (name \"Manufacturer\") (value \"AMS\")))\n    (comp (ref \"U3\") (value \"INA226AIDGSR\") (footprint \"Package_SO:VSSOP-10_3x3mm_P0.5mm\") (property (name \"MPN\") (value \"INA226AIDGSR\")) (property (name \"Manufacturer\") (value \"Texas Instruments\")))\n    (comp (ref \"U4\") (value \"CD74HC4051M\") (footprint \"Package_SO:SOIC-16_3.9x9.9mm_P1.27mm\") (property (name \"MPN\") (value \"CD74HC4051M96\")) (property (name \"Manufacturer\") (value \"Texas Instruments\")))\n    (comp (ref \"U5\") (value \"MCP6001T-I/OT\") (footprint \"Package_TO_SOT_SMD:SOT-23-5\") (property (name \"MPN\") (value \"MCP6001T-I/OT\")) (property (name \"Manufacturer\") (value \"Microchip\")))\n    (comp (ref \"U6\") (value \"LM4040AIM3-2.0\") (footprint \"Package_TO_SOT_SMD:SOT-23\") (property (name \"MPN\") (value \"LM4040AIM3-2.0/NOPB\")) (property (name \"Manufacturer\") (value \"Texas Instruments\")))\n    (comp (ref \"R_SHUNT\") (value \"1.0mOhm 5W Kelvin\") (footprint \"Resistor_SMD:R_Shunt_4Wire_CSS4J_4026\") (property (name \"MPN\") (value \"CSS4J-4026R-1L00F\")) (property (name \"Manufacturer\") (value \"Bourns\")))\n  