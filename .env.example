# CellGuard Runtime Configuration
# Copy to .env and adjust for your bench setup. Never commit real credentials.

CELLGUARD_HOST=127.0.0.1
CELLGUARD_PORT=8006
CELLGUARD_DB_PATH=./cellguard_telemetry.db

# Pack Baseline Profile (21700 Li-Ion NMC/INR, monitored ALONGSIDE commercial BMS + main fuse)
CELLGUARD_SERIES_CELLS=4
CELLGUARD_PARALLEL_CELLS=1
CELLGUARD_NOMINAL_CAPACITY_MAH=5000.0
CELLGUARD_NOMINAL_RDC_CELL_MOHM=22.0
CELLGUARD_SHUNT_MOHM=1.0
CELLGUARD_MAX_CURRENT_A=60.0

# Optional ESP32 Serial Telemetry Bridge
CELLGUARD_SERIAL_PORT=
CELLGUARD_SERIAL_BAUD=115200

# Safety Alarm Defaults
CELLGUARD_CELL_OV_V=4.22
CELLGUARD_CELL_UV_V=3.00
CELLGUARD_CELL_DELTA_MV=80.0
CELLGUARD_TEMP_WARN_C=50.0
CELLGUARD_TEMP_CRIT_C=60.0
CELLGUARD_DTDT_WARN_C_MIN=2.0
CELLGUARD_DTDT_CRIT_C_MIN=5.0
